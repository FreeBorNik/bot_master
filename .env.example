# Реестр child-ботов (read-only, из bot_sender)
SENDER_DB_PATH=/path/to/bot_sender/data/bot_sender.db
SENDER_ENCRYPTION_KEY=/path/to/bot_sender/data/encryption.key
# Опционально: нужен только если db_path в recipient_bots — относительный путь
# RECIPIENTS_DB_DIR=/path/to/bot_sender/data/recipients/

# Общие настройки runner
LOG_LEVEL=INFO
LOG_FILE=logs/bot_master.log
MAILING_DELAY=0.05
